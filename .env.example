# ---- Required -------------------------------------------------------------
# PostgreSQL connection string used by Drizzle ORM.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- Admin / owner identification (recommended) ---------------------------
# NUMERIC GitHub account id of the project owner. This is the only thing that
# grants admin rights. Find it with: curl https://api.github.com/users/<login>
# If it is not set, NOBODY is admin (the app fails closed).
OWNER_GITHUB_ID=

# One-time secret that allows /setup to provision OWNER_GITHUB_ID in the
# database when the environment variable is not used. Keep it long and random.
ADMIN_SETUP_TOKEN=

# ---- GitHub OAuth App (optional login) ------------------------------------
# Create at https://github.com/settings/developers
# Callback URL: https://<your-host>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only needed when the public host differs from the request host (proxy setups).
GITHUB_REDIRECT_URI=

# ---- GitHub publishing (admin feature) ------------------------------------
# A fine-grained PAT or classic token with Contents: write on the target repo.
# Used only on the server; never sent to the browser.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
GITHUB_PROJECTS_PREFIX=projects

# ---- Optional cloud inference (explicitly separate from local AI) ---------
# Without these the cloud route answers 503 and local WebGPU models are used.
AI_PROXY_URL=
AI_PROXY_KEY=

# ---- Optional: force Secure cookies behind a plain-HTTP proxy -------------
# Cookies are marked Secure automatically when the request arrives via HTTPS.
# COOKIE_SECURE=true
